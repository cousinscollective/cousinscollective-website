{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/",              "dest": "/index.html"   },
    { "src": "/booking",       "dest": "/booking.html" },
    { "src": "/booking.html",  "dest": "/booking.html" },
    { "src": "/sitemap.xml",   "dest": "/sitemap.xml"  },
    { "src": "/robots.txt",    "dest": "/robots.txt"   },
    { "src": "/(.*)",          "dest": "/$1"           }
  ]
}
